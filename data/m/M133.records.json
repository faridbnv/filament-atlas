s":["ISO 178"],"printParameters":"Test Equipment Adventurer 5M (Flashforge); Nozzle Diameter 0.6mm; Nozzle Temperature 230 °C; Printing Speed 150mm/s; Wall Thickness 1.2mm; Infill 100%","page":1,"at":"Bending Strength (X-Y) ISO 178 Mpa","uses":["flexuralStrengthXY"]},{"id":"V005369","product":"G133-01","property":"HDT","source":"D-FLASH-PBAT-TDS-EN","value":90,"unit":"°C","raw":"90 ℃","status":"Published value (physically implausible)","numeric":true,"implausible":true,"specimenType":"Printed specimen","form":"printed","direction":"Not applicable","readsAs":"Not applicable","bar":"unstated","moisture":"not-stated","treatment":"not-stated","standards":["ISO 75"],"standardText":"0.455 MPa 66 psi ISO 75","load":0.45,"page":1,"at":"HDT@ 0.455 MPa (66 psi) ISO 75 ℃","note":"Corrected against the source: the sheet states how its test bars were made, once for the table: \"Testing Specimen Printing Conditions:\". Flagged physically implausible: the sheet prints a heat deflection of 90 °C at 0.455 MPa beside its own modulus of elasticity of 6~7 MPa (V005367) and an elongation at break of 400~600 %. ISO 75 records the temperature at which the loaded bar bends a further 0.2 % of outer-fibre strain; the load alone strains a 6 MPa bar about 7 %, and a 3 % fall of its modulus meets the criterion, so the bar the sheet describes cannot hold to 90 °C in that test (PBAT melts at 110 to 120 °C). The number is not a rigid bar's softening point; HDT does not apply to so soft a bar. Kept as printed; it backs nothing.","why":"implausible"},{"id":"V005370","product":"G133-01","property":"Continuous service temperature","source":"D-FLASH-PBAT-TDS-EN","value":85,"unit":"°C","raw":"85 ℃","status":"Published value","numeric":true,"specimenType":"Not published (do not assume printed)","form":"not-stated","direction":"Not applicable","readsAs":"Not applicable","bar":"unstated","moisture":"not-stated","treatment":"not-stated","standards":["IEC 60216"],"page":1,"at":"Continuous Service Temperature IEC 60216 ℃"},{"id":"V015856","product":"G133-01","property":"Izod impact strength","source":"D-FLASH-PBAT-TDS-EN","unit":"kJ/m²","raw":"NB","status":"Published qualitative result","qualitative":true,"specimenType":"Printed specimen","form":"printed","direction":"XY","readsAs":"XY","bar":"in-plane","moisture":"not-stated","treatment":"not-stated","standards":["ISO 180"],"notch":"Not published","printParameters":"Test Equipment Adventurer 5M (Flashforge); Nozzle Diameter 0.6mm; Nozzle Temperature 230 °C; Printing Speed 150mm/s; Wall Thickness 1.2mm; Infill 100%","page":1,"at":"Izod Impact Strength (X-Y) ISO 180 KJ/m2","why":"no-number"}],"profiles":[{"id":"P0476","product":"G133-01","source":"D-FLASH-PBAT-TDS-EN","kind":"Manufacturer published guidance","at":"p. 2: Recommended printing settings: Nozzle Temperature; p. 2: Ambient Temperature for Printing; p. 3: Drying note; p. 2: Nozzle Diameter (recommended printing settings)","nozzle":{"text":"200~240℃ (230℃ recommended)","state":"range","requirement":"required","min":200,"max":240,"verdict":"within"},"bed":{"text":"Room temperature~60℃ (40℃ recommended)","state":"range","requirement":"required","min":25,"max":60,"verdict":"within"},"chamber":{"text":"Room temperature~40℃","state":"range","requirement":"required","min":25,"max":40,"verdict":"within"},"drying":{"text":"dry the filament in a hot dry air oven at 60℃ for at least 5 hours before use","state":"stated","need":"required","c":[null,60],"h":[null,5],"hoursOpen":true},"nozzleDiameter":"φ0.4/0.6mm (φ0.6mm recommended)","notes":[{"topic":"Speed","text":"150mm/s"},{"topic":"Shell / walls","text":"1.2mm"},{"topic":"Cooling","text":"50~100%"},{"topic":"Layer height","text":"0.2~0.3mm"},{"topic":"Retraction","text":"0.3~1mm"}]},{"id":"P1402","product":"G133-01","source":"R-FLASHFORGE-READER-20261004-b37ec3e86551","kind":"Current manufacturer product guidance","at":"p. 1: Specification","nozzle":{"text":"190~240°C","state":"range","requirement":"required","min":190,