within","state":"range","min":190,"max":240,"profileId":"P0957"},"bed":{"verdict":"within","state":"range","min":50,"max":60,"profileId":"P1834"},"chamber":{"verdict":"unknown","state":"unknown","min":null,"max":null,"profileId":"P0957"},"enclosure":null,"drying":null,"hardened":null,"anneal":[],"advice":null,"from":{},"profileIds":["P0957","P1834"],"fromId":{},"replaced":{"nozzle":["P1834"]}},"ledger":{"tensileModulusXY":[{"rule":"CV60","kind":"demote-to-ceiling","deciding":false,"level":"comparable","lo":null,"hi":5.5216,"measurementId":"V009761","value":4.76,"factor":1.16}]},"price":null,"notes":[{"topic":"Benefits","items":[{"id":"Q06952","text":"This high stone-filling has resulted in a 3D printer filament with remarkable aesthetic features.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06954","text":"StoneFil is a filament which is based on our modified and easy-to-print EasyFil PLA compound.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06955","text":"Easy to print","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Surface finish","items":[{"id":"Q01448","text":"StoneFil™ is an easy-to-print filament and printed objects have an extremely matte stone-like finish with unique natural gradient linings resulting in a unique chromatic spectrum per print.","source":"S-PET-TDS-StoneFil","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06951","text":"StoneFil is a PLA-based 3D printer filament with a 50% powdered stone filling, which give 3D printed parts true stone-like aesthetics and a rough and matt stone-like surface finish.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06953","text":"StoneFil is an easy-to-print 3D printer filament and printed objects have an extremely matte stone-like finish.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06956","text":"Matte and rough stone-like finish","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Nozzle wear","items":[{"id":"Q06958","text":"StoneFil has a very high filling with stone powders and therefore the filament can have a slightly more abrasive effect on brass nozzles than unfilled filaments.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Printing advice","items":[{"id":"Q06957","text":"Experience level: Beginner","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06959","text":"When printing with filled/composite filaments it is recommended to clean your nozzle immediately after printing by feeding 15-20cm PLA filament through your nozzle.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06960","text":"This will make sure that any potential fillers are flown out of your nozzle.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q06961","text":"It is even better to use glow in the dark PLA as the extremely hard phosphorous particles are much more likely to scrape out residual waste from your nozzle.","source":"R-FORMFUTURA-READER-20261004-b19edbf353e1","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"}]}]},{"id":"G012-07","name":"Spectrum PLA Stone Age","maker":"Spectrum","variant":null,"diameter":"1.75 mm","twins":[],"composition":null,"certifications":null,"avail