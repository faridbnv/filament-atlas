thZ","id":"V013768","value":7.86,"by":"R-QIDI-ASA-AERO","differs":false}],"print":{"nozzle":{"verdict":"within","state":"range","min":240,"max":280,"profileId":"P1248"},"bed":{"verdict":"within","state":"range","min":80,"max":110,"profileId":"P1248"},"chamber":{"verdict":"within-low-end","state":"range","min":40,"max":70,"profileId":"P1248"},"enclosure":null,"drying":{"need":"optional","c":[70,80],"h":[6,8],"hoursOpen":false,"profileId":"P1766"},"hardened":false,"anneal":[],"advice":null,"from":{},"profileIds":["P1248","P1766"],"fromId":{},"replaced":{"nozzle":["P1766"],"bed":["P1766"]}},"price":null,"notes":[{"topic":"Benefits","items":[{"id":"Q02596","text":"With this technique, it is easy to reduce the weight of the model.","source":"R-QIDI-ASA-AERO","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q02597","text":"In the best-case scenario, the model weight can be reduced to 50% of a model printed with ordinary ASA.","source":"R-QIDI-ASA-AERO","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q02598","text":"QIDI ASA-Aero is a type of ASA filament that will start foaming with the aid of a blowing agent during the printing process.","source":"R-QIDI-ASA-AERO","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Pitfalls and limitations","items":[{"id":"Q02601","text":"Since ASA-Aero adops the ‘on-demand foaming’ technology, the filament will continue to expand in the nozzle after being heated during the printing process.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q02602","text":"Therefore, it will cause unavoidable stringing during the nozzle movement.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q02603","text":"Even adjusting the retraction setting in the slicing software cannot solve this problem.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Warping and shrinkage","items":[{"id":"Q02604","text":"Because ASA materials have a high glass transition temperature, a certain ambient temperature ( 40-70°C ) is required during printing to release the internal stress of the printed parts and reduce warping.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Surface finish","items":[{"id":"Q02599","text":"In addition to that, the matte texture of the printed surface can reduce the visibility of printed layers and thus give a smooth surface finish.","source":"R-QIDI-ASA-AERO","at":"p. 1","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Odour and emissions","items":[{"id":"Q02605","text":"When printing with ASA-Aero filaments, please place the enclosed printer in a ventilated environment.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"}]},{"topic":"Printing advice","items":[{"id":"Q02606","text":"Based on the above, it is recommended to turn off the retraction setting.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q02607","text":"When printing thin-walled models without any form of insulation, it is recommended to use nozzles with a diameter of 0.6mm or more to ensure the strength of printed parts and reduce shrinkage.","source":"R-QIDI-ASA-AERO","at":"p. 4","domain":"Makers' know-how","type":"Manufacturer statement"}]}]}],"layers":[{"part":"tensileStrength","pairs":[{"id":"G032-04","name":"QIDI ASA-Aero","xy":8.25,"z":7.86,"annealed":false}],"unpaired":[]},{"part":"elongation","pairs":[{"id":"G032-04","name":"QIDI ASA-Aero","xy":11.52,"z":5.54,"annealed":false}],"unpaired":[]},{"part":"flexuralStrength","pairs":[],"unpaired":[{"id":"G032-01","name":"Bambu Lab ASA Aero","why":"no flat value compared"}]}],"published":[{"property":"Water absorption","domain"