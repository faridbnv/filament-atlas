 applicable","conditions":"Maker exact-product qualitative UV statement. Exposure protocol, UV spectrum/intensity, duration, specimen and measured retention are not stated; colour scope and comparative/raw wording remain as printed. No service qualification or requirement pass.","type":"Manufacturer statement","at":"p. 2","reads":"unread"}]},{"category":"flammability","meaning":"Flammability","items":[{"product":"Bambu Lab ASA Aero","verdict":"flammable","text":"Flammable","source":"B-asa-aero-TDS","id":"Q00133","productId":"G032-01","topic":"Flammability","agent":null,"strength":"Not applicable","conditions":"p. 3; concentration, duration and temperature not specified unless stated. Not a chemical design limit.","type":"Manufacturer statement","at":"Flammability","reads":"contrary"}]}],"guide":null,"resin":null,"sources":[{"id":"B-asa-aero-TDS","publisher":"Bambu Lab","title":"Bambu Filament Technical Data Sheet - ASA Aero","date":null,"read":"2026-09-10","kind":"Manufacturer TDS","url":"https://store.bblcdn.com/s1/default/02b005fdf02d450084e3128f7cf0c36f/Bambu_ASA_Aero_Technical_Data_Sheet.pdf","revision":"Technical Data Sheet V1.0"},{"id":"PR-asa","publisher":"Prusa Research","title":"ASA | Prusa Knowledge Base","date":null,"read":"2026-09-10","kind":"Manufacturer product page or guide","url":"https://help.prusa3d.com/article/asa_1809"},{"id":"R-BAMBU-PRIORITY-20261003-f50ef28e766c","publisher":"Bambu Lab","title":"ASA Aero official maker product page","date":null,"read":"2026-10-03","kind":"Manufacturer product page or guide","url":"https://ca.store.bambulab.com/products/asa-aero","note":"Exact official maker original. Source-wording conflicts, current/legacy identity and undefined use conditions retained. AI review only."},{"id":"R-COLORFABB-TDS-E-colorFabb-LW-ASA","publisher":"colorFabb","title":"Technical datasheet Light Weight ASA (LW-ASA)","date":null,"read":"2026-09-19","kind":"Manufacturer TDS","url":"https://downloads.colorfabb.com/public.php/dav/files/r