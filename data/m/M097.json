le for extended periods of time when not extruding.","source":"R-3D4MAKERS-TDS-PEEK-Filament-1","at":"p. 2","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q04581","text":"This will lead to speccing and nozzle blockages.","source":"R-3D4MAKERS-TDS-PEEK-Filament-1","at":"p. 2","domain":"Makers' know-how","type":"Manufacturer statement"},{"id":"Q04582","text":"You could post 3D printing anneal your PEEK part in an oven.","source":"R-3D4MAKERS-TDS-PEEK-Filament-1","at":"p. 2","domain":"Makers' know-how","type":"Manufacturer statement"}]}]},{"id":"G097-07","name":"Ensinger TECAFIL PEEK EV natural - 1.75 mm","maker":"Ensinger","variant":null,"diameter":"1.75 mm","twins":[],"composition":null,"certifications":"Flammability (UL94) 125x13x1,5mm V0 DIN IEC 60695-11-10; 2) (p. 1, as printed; a typical value, not a certificate: verify grade, thickness and certificate)","availability":null,"claim":null,"values":[{"key":"tensileModulusXY","id":"V008877","value":3.543,"mark":"counted","why":null,"annealed":null,"source":"R-FILAMENT2PRINT-PEEK-EV-Nat","page":1,"twin":null,"admitted":["moisture","treatment"],"at":"Modulus of elasticity"},{"key":"tensileStrengthXY","id":"V008875","value":89.3,"mark":"counted","why":null,"annealed":null,"source":"R-FILAMENT2PRINT-PEEK-EV-Nat","page":1,"twin":null,"admitted":["moisture","treatment"],"at":"Tensile strength"},{"key":"elongationXY","id":"V008881","value":119.5,"mark":"counted","why":null,"annealed":null,"source":"R-FILAMENT2PRINT-PEEK-EV-Nat","page":1,"twin":null,"admitted":["moisture","treatment"],"at":"Elongation at break (tensile test)"},{"key":"glassTransition","id":"V008884","value":143,"mark":"counted","why":null,"annealed":null,"source":"R-FILAMENT2PRINT-PEEK-EV-Nat","page":1,"twin":null,"admitted":["moisture"],"at":"Glass transition temperature"}],"listings":[],"held":[],"replaced":[],"print":{"nozzle":{"verdict":"exceeds","state":"range","min":420,"max":440,"profileId":"P0837"},"bed":{"verdict":"exceeds","sta